{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["es6", "dom"],
    "jsx": "react-jsx",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "types": ["react"]
  },
  "include": ["src/**/*"]
}
