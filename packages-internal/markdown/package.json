    "directory": "packages-internal/markdown"
  },
  "scripts": {
    "release:publish": "pnpm publish --tag latest",
    "release:publish:dry-run": "pnpm publish --tag latest --registry=\"http://localhost:4873/\""
  },
  "dependencies": {
