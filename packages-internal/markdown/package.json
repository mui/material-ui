    "./demoPipeline": {
      "types": "./demoPipeline.d.mts",
      "import": "./demoPipeline.mjs"
    },
    "./loader": "./loader.mjs",
    "./precomputeDocsInfraDemo": {
      "types": "./precomputeDocsInfraDemo.d.mts",
