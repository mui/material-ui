{
  "name": "@mui/codemod",
  "version": "9.3.1",
  "author": "MUI Team",
  "description": "Codemod scripts for Material UI.",
  "license": "MIT",
  "bin": "./src/codemod.js",
  "keywords": [
    "react",
    "react-component",
    "mui",
    "codemod",
    "jscodeshift"
  ],
  "scripts": {
    "test": "pnpm --workspace-root test:unit --project \"*:@mui/codemod\"",
    "build": "code-infra build --flat --bundle cjs --buildTypes false --ignore \"**/*.test/**\" --ignore \"**/actual.js\" --ignore \"**/expected.js\" --ignore \"**/test-cases/**\"",
    "release": "pnpm build && pnpm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mui/material-ui.git",
    "directory": "packages/mui-codemod"
  },
  "homepage": "https://github.com/mui/material-ui/tree/master/packages/mui-codemod",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/mui-org"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/runtime": "^8.0.0",
    "@babel/traverse": "^8.0.4",
    "@mui/material-v5": "npm:@mui/material@5.18.0",
    "jscodeshift": "^17.4.0",
    "jscodeshift-add-imports": "^1.0.11",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@material-ui/core": "^4.12.4",
    "@types/jscodeshift": "17.3.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "build"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
