<TabContext value={value}>
  <TabList
    onChange={handleChange}
    aria-label="lab tabs"
    sx={{ borderBottom: 1, borderColor: 'divider' }}
  >
    <Tab label="Item One" value="1" />
    <Tab label="Item Two" value="2" />
  </TabList>
  <TabPanel value="1" tabIndex={0}>
    Item One
  </TabPanel>
  <TabPanel value="2" tabIndex={0}>
    Item Two
  </TabPanel>
</TabContext>