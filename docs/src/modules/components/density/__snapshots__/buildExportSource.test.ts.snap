            '&[data-popper-placement*="left"] .MuiTooltip-arrow': {
              height: 'var(--_arrowSize)',
              width: 'calc(var(--_arrowSize) * 0.71)',
              marginInlineEnd: 'calc(var(--_arrowSize) * -0.71)',
