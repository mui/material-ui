exports[`buildExportSource > snapshot of a small representative export 1`] = `
"// density.ts — generated by the density playground.
// Preview MUI density WITHOUT upgrading @mui/material — the unreleased preset
// logic is inlined as data + a ported \`applyDensity\`; only a type is imported.
//
// The generated \`enhance\` mirrors the real enhance*Density presets:
//   • CSS-vars theme (createTheme({ cssVariables: true })) — the scale rides the
//     theme's own vars channel (--mui-density-* on generateStyleSheets, same as
//     the palette vars); ThemeProvider alone applies density, no <CssBaseline/>.
//   • static theme (createTheme()) — the baked var(--mui-density-*) refs resolve
//     to raw px at runtime; ThemeProvider alone, still no <CssBaseline/>.
//
// Usage:
//   const theme = enhanceHighDensity(createTheme({ /* your options */ }));
//   <ThemeProvider theme={theme}>…</ThemeProvider>
import type { Theme } from '@mui/material/styles';

type AnyRecord = Record<string, any>;

// Per-preset payload, baked at export time — each preset carries ITS OWN
// playground edits (the playground keeps one override workspace per preset):
//   scale      → { 'xx-small': '<px>', … } — the DensityScale, exposed on theme.density
//   components → preset baseline emissions ⊕ that preset's edits (flat-array
//                slots); density sizes stay var(--mui-density-*) refs
//   typography → the preset's own type reflow ⊕ that preset's typography edits
//   shape      → that preset's shape edits (borderRadius)
//   spacing    → theme.spacing base px, when the preset tunes it (else omitted)
// Playground edits are marked inline: appended slot layers sit between
// "user overrides" comments; edited token leaves carry a "playground edit" tag.
const high = {
  scale: {
    'xx-small': '2px',
    'x-small': '4px',
    small: '8px',
    medium: '12px',
    large: '16px',
    'x-large': '24px',
    'xx-large': '32px',
    'touch-target': '28px',
  },
  components: {
    MuiButton: {
      styleOverrides: {
        root: [
          {
            fontSize: 'calc(0.75rem * var(--mui-scaling))',
            lineHeight: 'calc(16px * var(--mui-scaling))',
            textTransform: 'initial',
            letterSpacing: 0,
            fontFamily: '"Roboto", "Helvetica", "Arial", sans-serif',
            fontWeight: 500,
            paddingBlock: 0,
            variants: [
              {
                props: {
                  size: 'small',
                },
                style: {
                  height: 'var(--mui-density-large)',
                  paddingInline: 'var(--mui-density-small)',
                },
              },
              {
                props: {
                  size: 'medium',
                },
                style: {
                  height: 'var(--mui-density-touch-target)',
                  paddingInline: 'var(--mui-density-medium)',
                },
              },
              {
                props: {
                  size: 'large',
                },
                style: {
                  height: 'var(--mui-density-xx-large)',
                  paddingInline: 'var(--mui-density-large)',
                },
              },
            ],
          },
          // ─── user overrides (playground edits) — appended layer, wins by order ───
          {
            variants: [
              {
                props: {
                  size: 'medium',
                },
                style: {
                  paddingInline: 'var(--mui-density-x-small)',
                },
              },
            ],
          },
          // ─── end user overrides ───
        ],
        startIcon: [
          {
            '& > *:nth-of-type(1)': {
              fontSize: '0.8lh',
            },
          },
        ],
        endIcon: [
          {
            '& > *:nth-of-type(1)': {
              fontSize: '0.8lh',
            },
          },
        ],
      },
    },
    MuiIconButton: {
      styleOverrides: {
        root: [
          {
            padding: 0,
            fontSize: 'var(--mui-density-medium)',
            variants: [
              {
                props: {
                  size: 'small',
                },
                style: {
                  width: 'var(--mui-density-large)',
                  height: 'var(--mui-density-large)',
                },
              },
              {
                props: {
                  size: 'medium',
                },
                style: {
                  width: 'var(--mui-density-touch-target)',
                  height: 'var(--mui-density-touch-target)',
                },
              },
              {
                props: {
                  size: 'large',
                },
                style: {
                  width: 'var(--mui-density-xx-large)',
                  height: 'var(--mui-density-xx-large)',
                },
              },
              {
                props: {
                  edge: 'start',
                },
                style: {
                  marginLeft: 'calc(var(--mui-density-touch-target) / -8)',
                },
              },
              {
                props: {
                  edge: 'end',
                },
                style: {
                  marginRight: 'calc(var(--mui-density-touch-target) / -8)',
                },
              },
            ],
          },
        ],
      },
    },
    MuiSvgIcon: {
